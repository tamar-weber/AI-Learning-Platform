# Server
PORT=8000
NODE_ENV=development

# Database
# For running locally with plain `node server.js` / `npm start`:
MONGODB_URI=mongodb://localhost:27017/ai-learning-platform
# Note: when running via `docker-compose up`, this is automatically
# overridden to point at the "mongo" container - see docker-compose.yml.

# Authentication
# Any string works for local dev. Use a long random value in production.
JWT_SECRET=local-dev-secret-change-me

# OpenAI (optional for local dev)
# Leave empty to run without a real key - the RAG chat assistant will
# return a friendly fallback response instead of calling OpenAI, and the
# rest of the app works normally.
OPENAI_API_KEY=

# Stripe (optional for local dev)
# Leave both empty to enable local fake-payment mode: clicking "Enroll"
# will instantly create the enrollment locally, without calling Stripe or
# needing a webhook. Fill these in only if you want to test real Stripe
# Checkout + webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (optional for local dev)
# Leave empty to skip sending real emails - all email sends are
# non-blocking, so signup/enrollment/password-reset keep working; the
# failure is just logged to the console instead.
EMAIL_USER=
EMAIL_PASS=

# Client (used to build links in emails and Stripe redirect URLs)
FRONTEND_URL=http://localhost:3000
